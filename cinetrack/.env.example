# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, bypasses Row Level Security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# TMDb — account Settings → API → "API Read Access Token (v4 auth)"
TMDB_API_ACCESS_TOKEN=

# Optional — OMDb repackages IMDb's own rating; free tier is 1,000 requests/day.
# Leave blank to skip it entirely; nothing else depends on it.
# Get a key at https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# Any random string (e.g. `openssl rand -hex 32`). Set the same value in your
# Vercel project's env vars — Vercel Cron then sends it automatically as a
# Bearer token when it calls /api/cron/sync, so only Vercel can trigger a sync.
CRON_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
